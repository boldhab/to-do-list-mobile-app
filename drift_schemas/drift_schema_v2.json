  "fixed_sql": [
    {
      "name": "monthly_goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"monthly_goals\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"year\" INTEGER NOT NULL, \"month\" INTEGER NOT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(id)) > 0), CHECK (length(trim(title)) BETWEEN 1 AND 100), CHECK (year BETWEEN 1 AND 9999 AND month BETWEEN 1 AND 12));"
        }
      ]
    },
    {
      "name": "weekly_goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weekly_goals\" (\"id\" TEXT NOT NULL, \"monthly_goal_id\" TEXT NULL REFERENCES monthly_goals (id) ON DELETE RESTRICT, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"week_start\" INTEGER NOT NULL, \"week_end\" INTEGER NOT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(id)) > 0), CHECK (length(trim(title)) BETWEEN 1 AND 100), CHECK (week_start BETWEEN -719162 AND 2932896 AND week_end BETWEEN -719162 AND 2932896), CHECK (((week_start + 3) % 7 + 7) % 7 = 0 AND week_end = week_start + 6));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"weekly_goal_id\" TEXT NULL REFERENCES weekly_goals (id) ON DELETE RESTRICT, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"scheduled_date\" INTEGER NOT NULL, \"due_at\" TEXT NULL, \"priority\" TEXT NOT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"completed_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(id)) > 0), CHECK (length(trim(title)) BETWEEN 1 AND 100), CHECK (scheduled_date BETWEEN -719162 AND 2932896), CHECK (priority IN ('low', 'medium', 'high')), CHECK ((is_completed = 1 AND completed_at IS NOT NULL) OR (is_completed = 0 AND completed_at IS NULL)));"
        }
      ]
    },
    {
      "name": "recurrence_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurrence_rules\" (\"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"frequency\" TEXT NOT NULL, \"interval\" INTEGER NOT NULL, \"weekdays\" INTEGER NOT NULL, \"month_day\" INTEGER NOT NULL, \"start_day\" INTEGER NOT NULL, \"end_day\" INTEGER NULL, \"occurrence_count\" INTEGER NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"task_id\"), CHECK (frequency IN ('daily', 'weekly', 'monthly')), CHECK (interval >= 1 AND weekdays BETWEEN 1 AND 127 AND month_day BETWEEN 1 AND 31), CHECK (occurrence_count IS NULL OR occurrence_count >= 1));"
        }
      ]
    },
    {
      "name": "occurrence_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"occurrence_states\" (\"task_id\" TEXT NOT NULL REFERENCES recurrence_rules (task_id) ON DELETE CASCADE, \"occurrence_day\" INTEGER NOT NULL, \"scheduled_day\" INTEGER NOT NULL, \"override_data\" TEXT NULL, \"skipped\" INTEGER NOT NULL DEFAULT 0 CHECK (\"skipped\" IN (0, 1)), \"completed_at\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"task_id\", \"occurrence_day\"));"
        }
      ]
    },
    {
      "name": "reminder_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_rules\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"occurrence_day\" INTEGER NULL, \"minutes_before\" INTEGER NULL, \"absolute_time\" TEXT NULL, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (enabled = 0 OR ((minutes_before IS NULL) != (absolute_time IS NULL))), CHECK (minutes_before IS NULL OR minutes_before >= 0));"
        }
      ]
    },
    {
      "name": "reminder_deliveries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_deliveries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"occurrence_key\" TEXT NOT NULL UNIQUE, \"fingerprint\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"fire_at\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "application_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"application_settings\" (\"id\" INTEGER NOT NULL, \"theme\" TEXT NOT NULL DEFAULT 'system', \"reminders_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"reminders_enabled\" IN (0, 1)), \"reminder_offset\" INTEGER NOT NULL DEFAULT 15, \"sunday_first\" INTEGER NOT NULL DEFAULT 0 CHECK (\"sunday_first\" IN (0, 1)), \"calendar_week\" INTEGER NOT NULL DEFAULT 0 CHECK (\"calendar_week\" IN (0, 1)), \"date_format\" TEXT NOT NULL DEFAULT 'medium', PRIMARY KEY (\"id\"));"
        }
      ]
    },
